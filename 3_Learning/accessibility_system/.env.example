# Copy to .env (git-ignored) and replace placeholders with real values.
# python-dotenv loads these via accessibility_system/env_import.py.

OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_API_MODE=chat_completions

# Reproducible bounded-generation defaults. A seed is best-effort and is sent
# only in Chat Completions mode because the Responses API has no seed field.
OPENAI_TEMPERATURE=0.0
OPENAI_TOP_P=1.0
OPENAI_SEED=42
OPENAI_MAX_OUTPUT_TOKENS=3000
OPENAI_REASONING_EFFORT=medium
OPENAI_VERBOSITY=low

# Frozen specialist model bundle used by the live suggestion-audit API.
# These defaults target the in-progress evidence-v3.0_1208 training output.
# Set absolute paths if a completed bundle lives elsewhere.
# ACCESSIBILITY_PHASE5_DIR=/absolute/path/to/phase_5_multiview_final_v2
# ACCESSIBILITY_FUSION_POLICY=/absolute/path/to/phase_6_7_final/phase_6_fusion_policy.json
